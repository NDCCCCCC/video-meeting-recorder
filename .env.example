# Record V2 - 后端环境变量示例
#
# 部署说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填写真实凭证
#   3. .env 已在 .gitignore 中，不会被提交
#   4. 推荐在生产环境使用系统级环境变量而非 .env 文件
#
# 注意：以下真实凭据仅作占位演示，部署前请替换为实际值

# ---------------------------------------------------------------------------
# 阿里通义听悟（用于云端转录）
# ---------------------------------------------------------------------------
TYTW_APP_KEY=YOUR_TYTW_APP_KEY_HERE
TYTW_APP_SECRET=YOUR_TYTW_APP_SECRET_HERE

# ---------------------------------------------------------------------------
# 阿里云认证
# ---------------------------------------------------------------------------
ALIYUN_ACCESS_KEY_ID=YOUR_ALIYUN_ACCESS_KEY_ID
ALIYUN_ACCESS_KEY_SECRET=YOUR_ALIYUN_ACCESS_KEY_SECRET

# ---------------------------------------------------------------------------
# 阿里云 OSS（文件存储）
# ---------------------------------------------------------------------------
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_OSS_ACCESS_KEY_ID=YOUR_OSS_ACCESS_KEY_ID
ALIYUN_OSS_ACCESS_KEY_SECRET=YOUR_OSS_ACCESS_KEY_SECRET

# ---------------------------------------------------------------------------
# SM4 / HLS 加密密钥（与 config.yaml 等效，但优先级更高）
# ⚠️ 必须显式设置，最小 32 字符；生产环境缺失或过短将触发 logger.Fatal 终止启动。
# ⚠️ SM4_SECRET 与 HLS_TOKEN_SECRET 必须互不相同。
# 生成命令: openssl rand -hex 16   # 或任意 ≥ 32 字符的高熵字符串
# ---------------------------------------------------------------------------
SM4_SECRET=<必须显式设置，最小 32 字符>
HLS_TOKEN_SECRET=<必须显式设置，最小 32 字符，且与 SM4_SECRET 互不相同>

# ---------------------------------------------------------------------------
# Phase 18 凭据静态加密密钥族（与传输密钥 SM4_SECRET 严格分离）
#
# CREDENTIAL_SM4_* 用于加密 SQLite 里的 input_configs.password / stream_password /
# system_settings[auth.ad.password] 等 at-rest 凭据；envelope 格式：
#   SM4:<version>:<base64(nonce_12B | ciphertext | tag_16B)>
#
# ⚠️  CREDENTIAL_SM4_VERSION 必须匹配 ^v[1-9][0-9]*$（如 v1）
# ⚠️  CREDENTIAL_SM4_SECRET 必须 ≥ 32 字符
# ⚠️  与 SM4_SECRET / HLS_TOKEN_SECRET 必须互不相同（独立密钥族）
# ⚠️  生产环境缺失或过短将触发 fail-closed 启动（Initialize() 直接返回 error）
#
# 轮换过渡期：填 *_PREVIOUS_* 提供旧版本密钥，启动后 RotateIfNeeded 自动改写。
# ---------------------------------------------------------------------------
CREDENTIAL_SM4_VERSION=v1
CREDENTIAL_SM4_SECRET=<必须显式设置，最小 32 字符；独立于 SM4_SECRET>
# 可选：轮换过渡期填两个字段即可启用 previous 密钥解析；未启用时保持空
# CREDENTIAL_SM4_PREVIOUS_VERSION=v0
# CREDENTIAL_SM4_PREVIOUS_SECRET=<必须显式设置，最小 32 字符；与 CREDENTIAL_SM4_SECRET 互不相同>

# ---------------------------------------------------------------------------
# 华为会议系统（可选）
# ---------------------------------------------------------------------------
HUAWEI_CONF_SERVER=conf.example.com
HUAWEI_USERNAME=your_username
HUAWEI_PASSWORD=your_password
