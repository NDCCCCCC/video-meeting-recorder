# ============================================================================
# Binaries / 编译产物
# ============================================================================
*.exe
*.exe~
*.dll
*.so
*.dylib
# bin/ 目录用于存放 ffmpeg 和 ffprobe 等运行时文件
# 忽略 bin/ 目录中的所有文件，但保留 .gitkeep 占位
bin/*
!bin/.gitkeep
dist/

# Test binary
*.test

# Output of go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# ============================================================================
# 数据库 / 运行时数据
# ============================================================================
data/*.db
data/*.db-shm
data/*.db-wal
data/

# ============================================================================
# 日志
# ============================================================================
logs/
*.log

# ============================================================================
# IDE / 编辑器
# ============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ============================================================================
# ⚠️ 敏感信息保护（关键）
# ============================================================================
# 部署时通过环境变量注入，避免硬编码到仓库
.env
.env.local
.env.*.local
config.yaml
config.local.yaml
config.*.local.yaml

# TLS 证书 / 私钥（部署时重新生成）
certs/*.crt
certs/*.pem
certs/*.key
# CA chain 文本（含服务器证书描述，非敏感但与构建无关）
certs/*.txt

# 前端 .env（含 VITE_SM4_SECRET、内网 IP 等敏感信息）
frontend/.env.development
frontend/.env.production

# Claude agent 临时工作树（不应进入版本控制）
.claude/worktrees/

# Claude / GSD 流程记录（项目级 skill 流程、个人笔记，不入仓库）
/.claude/
/.planning/

# ============================================================================
# 依赖目录 (根 + 所有子项目) 与前端构建产物
# ============================================================================
node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local
*.tsbuildinfo
# tsc --noEmit vs. emit 也会产出 vite.config.{js,d.ts};0e83baa 已删过但被后续 commit 重新引入。
# 这里双保险：本地未 emit 时不命中，已 emit 时被 ignore 拦住。
frontend/vite.config.js
frontend/vite.config.d.ts
internal/frontend/dist/

# ============================================================================
# 构建临时目录
# ============================================================================
scripts/bin/
scripts/internal/
# Python __pycache__ from `uv run python scripts/*.py` (already exists
# as an untracked artifact from the dependency-upgrade smoke tests).
# Use a directory pattern (not `**/__pycache__/`) to be conservative —
# only the scripts/ tree currently produces .pyc files; expanding the
# glob would surprise other parts of the repo.
scripts/__pycache__/

# ============================================================================
# 临时文件
# ============================================================================
tmp/
temp/
*.tmp

# ============================================================================
# OS / 杂项
# ============================================================================
Thumbs.db
*.bak
*.bak*
nul

# ============================================================================
# GitHub API 临时响应（含 token，不入仓库）
# ============================================================================
remote_ref.json
sec_remote.json
